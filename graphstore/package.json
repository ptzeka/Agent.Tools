{
  "name": "@peritze/graphstore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic relationship store: IGraphStore over typed, directed edges { from, to, type, line } partitioned by namespace, with a per-namespace file backend. Takes entity ids as input; never parses.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@peritze/vectorstore": "*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
