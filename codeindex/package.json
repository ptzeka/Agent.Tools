{
  "name": "@peritze/codeindex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository vectorizer — chunks, embeds, and publishes the working tree to a local file store for consumption by the codemcp server.",
  "bin": {
    "codeindex": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "jest",
    "start": "node dist/cli.js",
    "plan": "node dist/cli.js plan",
    "migrate": "node dist/cli.js migrate",
    "migrate:status": "node dist/cli.js migrate --status",
    "publish": "node dist/cli.js publish"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@peritze/graphstore": "*",
    "@peritze/vectorizer": "*",
    "@peritze/vectorstore": "*",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
